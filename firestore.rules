rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function perfilPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function perfilActivoConRol(rol) {
      let perfil = get(perfilPath(request.auth.uid)).data;
      return perfil.rol == rol && perfil.activo == true;
    }

    function isAdmin() {
      return signedIn() && perfilActivoConRol('administrador');
    }

    function isCocina() {
      return signedIn() && perfilActivoConRol('cocina');
    }

    function isMozo() {
      return signedIn() && perfilActivoConRol('mozo');
    }

    function mesaPath(mesaId) {
      return /databases/$(database)/documents/mesas/$(mesaId);
    }

    function productoPath(productoId) {
      return /databases/$(database)/documents/productos/$(productoId);
    }

    function atencionPath(atencionId) {
      return /databases/$(database)/documents/atenciones/$(atencionId);
    }

    function pedidoPath(atencionId, pedidoId) {
      return /databases/$(database)/documents/atenciones/$(atencionId)/pedidos/$(pedidoId);
    }

    function comandaPath(atencionId, pedidoId) {
      return /databases/$(database)/documents/atenciones/$(atencionId)/pedidos/$(pedidoId)/cocina/resumen;
    }

    function transicionPermitidaPorRol(anterior, siguiente) {
      return ((isAdmin() || isCocina())
          && ((anterior == 'recibido' && siguiente == 'preparando')
            || (anterior == 'preparando' && siguiente == 'listo')))
        || ((isAdmin() || isMozo()) && anterior == 'listo' && siguiente == 'entregado');
    }

    function itemComandaValido(item) {
      return item is map
        && item.keys().hasOnly(['productoId', 'nombre', 'presentacion', 'cantidad', 'observacion'])
        && item.productoId is string
        && item.nombre is string
        && item.nombre.size() > 0
        && item.nombre.size() <= 100
        && item.cantidad is int
        && item.cantidad >= 1
        && item.cantidad <= 1000000
        && (!item.keys().hasAny(['presentacion'])
          || (item.presentacion is string && item.presentacion.size() > 0 && item.presentacion.size() <= 60))
        && (!item.keys().hasAny(['observacion'])
          || (item.observacion is string && item.observacion.size() <= 300));
    }

    function itemComandaCoincide(itemPedido, itemResumen) {
      return itemResumen is map
        && itemResumen.keys().hasAll(['productoId', 'nombre', 'cantidad'])
        && itemResumen.keys().hasOnly(['productoId', 'nombre', 'presentacion', 'cantidad'])
        && itemResumen.productoId == itemPedido.productoId
        && itemResumen.nombre == itemPedido.nombre
        && itemResumen.cantidad == itemPedido.cantidad
        && (itemPedido.keys().hasAny(['presentacion'])
          ? itemResumen.keys().hasAny(['presentacion'])
            && itemResumen.presentacion == itemPedido.presentacion
          : !itemResumen.keys().hasAny(['presentacion']))
        && !itemResumen.keys().hasAny(['observacion']);
    }

    function itemsComandaCoinciden(itemsPedido, itemsResumen) {
      return itemsPedido is list
        && itemsResumen is list
        && itemsPedido.size() >= 1
        && itemsPedido.size() <= 4
        && itemsResumen.size() == itemsPedido.size()
        && itemComandaCoincide(itemsPedido[0], itemsResumen[0])
        && (itemsPedido.size() < 2 || itemComandaCoincide(itemsPedido[1], itemsResumen[1]))
        && (itemsPedido.size() < 3 || itemComandaCoincide(itemsPedido[2], itemsResumen[2]))
        && (itemsPedido.size() < 4 || itemComandaCoincide(itemsPedido[3], itemsResumen[3]));
    }

    function comandaVinculadaAlPedido(comanda, pedido, atencionId, pedidoId) {
      return comanda is map
        && comanda.keys().hasAll([
          'atencionId', 'pedidoId', 'mesaId', 'mesaNumero', 'creadoPor',
          'creadoEn', 'estado', 'items'
        ])
        && comanda.keys().hasOnly([
          'atencionId', 'pedidoId', 'mesaId', 'mesaNumero', 'creadoPor',
          'creadoEn', 'estado', 'items', 'observaciones'
        ])
        && comanda.atencionId == atencionId
        && comanda.pedidoId == pedidoId
        && comanda.mesaId == pedido.mesaId
        && comanda.mesaNumero == pedido.mesaNumero
        && comanda.creadoPor == pedido.creadoPor
        && comanda.creadoEn == pedido.creadoEn
        && itemsComandaCoinciden(pedido.items, comanda.items)
        && (pedido.keys().hasAny(['observaciones'])
          ? comanda.keys().hasAny(['observaciones'])
            && comanda.observaciones == pedido.observaciones
          : !comanda.keys().hasAny(['observaciones']));
    }

    function comandaValida(data) {
      return data is map
        && data.keys().hasAll([
          'atencionId', 'pedidoId', 'mesaId', 'mesaNumero', 'creadoPor',
          'creadoEn', 'estado', 'items'
        ])
        && data.keys().hasOnly([
          'atencionId', 'pedidoId', 'mesaId', 'mesaNumero', 'creadoPor',
          'creadoEn', 'estado', 'items', 'observaciones'
        ])
        && data.atencionId is string
        && data.pedidoId is string
        && data.mesaId is string
        && data.mesaNumero is number
        && data.creadoPor is string
        && data.creadoEn is timestamp
        && data.estado in ['recibido', 'preparando', 'listo', 'entregado']
        && data.items is list
        && data.items.size() >= 1
        && data.items.size() <= 4
        && itemComandaValido(data.items[0])
        && (data.items.size() < 2 || itemComandaValido(data.items[1]))
        && (data.items.size() < 3 || itemComandaValido(data.items[2]))
        && (data.items.size() < 4 || itemComandaValido(data.items[3]))
        && (!data.keys().hasAny(['observaciones'])
          || (data.observaciones is string && data.observaciones.size() <= 500));
    }

    function comandaCreateValida(atencionId, pedidoId) {
      let pedido = getAfter(pedidoPath(atencionId, pedidoId)).data;
      return comandaVinculadaAlPedido(request.resource.data, pedido, atencionId, pedidoId)
        && request.resource.data.estado == 'recibido'
        && pedido.estado == 'recibido';
    }

    function estadoPedidoActualizacionValida(atencionId, pedidoId) {
      let comanda = getAfter(comandaPath(atencionId, pedidoId)).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && transicionPermitidaPorRol(resource.data.estado, request.resource.data.estado)
        && get(comandaPath(atencionId, pedidoId)).data.estado == resource.data.estado
        && comanda.estado == request.resource.data.estado
        && comanda.atencionId == atencionId
        && comanda.pedidoId == pedidoId;
    }

    function estadoComandaActualizacionValida(atencionId, pedidoId) {
      let pedido = getAfter(pedidoPath(atencionId, pedidoId)).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && transicionPermitidaPorRol(resource.data.estado, request.resource.data.estado)
        && get(pedidoPath(atencionId, pedidoId)).data.estado == resource.data.estado
        && pedido.estado == request.resource.data.estado
        && resource.data.atencionId == atencionId
        && resource.data.pedidoId == pedidoId;
    }

    function pagoPath(atencionId, pagoId) {
      return /databases/$(database)/documents/atenciones/$(atencionId)/pagos/$(pagoId);
    }

    function atencionPagadaCerrada(atencionId) {
      let atencion = get(atencionPath(atencionId)).data;
      let pago = get(pagoPath(atencionId, atencion.pagoId)).data;
      return atencion.estado == 'cerrada'
        && atencion.pagoId is string
        && atencion.metodoPago in ['efectivo', 'yape']
        && atencion.totalPagadoCentimos is int
        && atencion.totalPagadoCentimos == atencionCentimos(atencion)
        && pago.importeCentimos == atencion.totalPagadoCentimos
        && pago.metodo == atencion.metodoPago;
    }

    function mesaDespues(mesaId) {
      return getAfter(mesaPath(mesaId));
    }

    function atencionDespues(atencionId) {
      return getAfter(atencionPath(atencionId));
    }

    function pedidoDespues(atencionId, pedidoId) {
      return getAfter(pedidoPath(atencionId, pedidoId));
    }

    // Legacy catalog records have only `precio` in soles. Their cents value is
    // derived for reads and order validation; nothing is migrated by this rule.
    function precioCatalogoCentimos(producto) {
      return producto.keys().hasAny(['precioCentimos'])
        ? producto.precioCentimos
        : int(producto.precio * 100 + 0.5000001);
    }

    function lineaValida(item) {
      let producto = getAfter(
        /databases/$(database)/documents/productos/$(item.productoId)
      ).data;
      let precioCentimos = precioCatalogoCentimos(producto);
      return item is map
        && item.productoId is string
        && producto.activo == true
        && item.nombre == producto.nombre
        && item.keys().hasOnly([
          'productoId', 'nombre', 'presentacion', 'precioUnitarioCentimos', 'cantidad', 'subtotalCentimos'
        ])
        && (producto.keys().hasAny(['presentacion'])
          ? item.keys().hasAny(['presentacion'])
            && item.presentacion == producto.presentacion
          : !item.keys().hasAny(['presentacion']))
        && precioCentimos is int
        && precioCentimos >= 0
        && precioCentimos <= 10000000000
        && item.precioUnitarioCentimos is int
        && item.precioUnitarioCentimos == precioCentimos
        && item.cantidad is int
        && item.cantidad >= 1
        && item.cantidad <= 1000000
        && item.subtotalCentimos is int
        && item.subtotalCentimos == precioCentimos * item.cantidad;
    }

    // Requiring sorted IDs proves uniqueness with one comparison per neighbor.
    function lineasOrdenadas(items) {
      return (items.size() < 2 || items[0].productoId < items[1].productoId)
        && (items.size() < 3 || items[1].productoId < items[2].productoId)
        && (items.size() < 4 || items[2].productoId < items[3].productoId);
    }

    function lineasValidas(items) {
      return items is list
        && items.size() >= 1
        && items.size() <= 4
        && lineaValida(items[0])
        && (items.size() < 2 || lineaValida(items[1]))
        && (items.size() < 3 || lineaValida(items[2]))
        && (items.size() < 4 || lineaValida(items[3]))
        && lineasOrdenadas(items);
    }

    function totalLineasCentimos(items) {
      return items[0].subtotalCentimos
        + (items.size() > 1 ? items[1].subtotalCentimos : 0)
        + (items.size() > 2 ? items[2].subtotalCentimos : 0)
        + (items.size() > 3 ? items[3].subtotalCentimos : 0);
    }

    function atencionCentimos(data) {
      return data.keys().hasAny(['totalCentimos'])
        ? data.totalCentimos
        : int(data.total * 100 + 0.5000001);
    }

    function productoValido(data) {
      return data.keys().hasAll(['nombre', 'categoria', 'precio', 'precioCentimos', 'activo'])
        && data.keys().hasOnly([
          'nombre', 'categoria', 'precio', 'precioCentimos', 'activo', 'presentacion'
        ])
        && data.nombre is string
        && data.nombre.size() > 0
        && data.nombre.size() <= 100
        && data.categoria is string
        && data.categoria.size() > 0
        && data.categoria.size() <= 60
        && data.precio is number
        && data.precio >= 0
        && data.precioCentimos is int
        && data.precioCentimos >= 0
        && data.precioCentimos <= 10000000000
        && data.precio == data.precioCentimos / 100
        && data.activo is bool
        && (!data.keys().hasAny(['presentacion'])
          || (data.presentacion is string
            && data.presentacion.size() > 0
            && data.presentacion.size() <= 60))
        && (!(data.categoria in ['Bebidas frías', 'Bebidas calientes'])
          || data.keys().hasAny(['presentacion']));
    }

    function pedidoCreateValido(data, atencionId, pedidoId) {
      let actual = get(atencionPath(atencionId)).data;
      let despues = atencionDespues(atencionId).data;
      let mesa = mesaDespues(data.mesaId).data;
      let totalAnterior = atencionCentimos(actual);
      return actual.estado == 'abierta'
        && totalAnterior is int
        && totalAnterior <= 9000000000000000000 - data.totalCentimos
        && actual.mesaId == data.mesaId
        && actual.mesaNumero == data.mesaNumero
        && despues.estado == 'abierta'
        && despues.mesaId == data.mesaId
        && despues.mesaNumero == data.mesaNumero
        && despues.ultimoPedidoId == pedidoId
        && despues.totalCentimos == totalAnterior + data.totalCentimos
        && despues.total == despues.totalCentimos / 100
        && mesa.estado == 'ocupada'
        && mesa.atencionActivaId == atencionId
        && mesa.numero == data.mesaNumero;
    }

    function atencionActualizacionValida(atencionId) {
      let pedido = pedidoDespues(atencionId, request.resource.data.ultimoPedidoId).data;
      let mesa = mesaDespues(resource.data.mesaId).data;
      let totalAnterior = atencionCentimos(resource.data);
      let totalPedido = pedido.totalCentimos;
      return totalAnterior is int
        && (!resource.data.keys().hasAny(['ultimoPedidoId'])
          || request.resource.data.ultimoPedidoId != resource.data.ultimoPedidoId)
        && totalPedido is int
        && totalAnterior <= 9000000000000000000 - totalPedido
        && pedido.atencionId == atencionId
        && pedido.mesaId == resource.data.mesaId
        && pedido.mesaNumero == resource.data.mesaNumero
        && pedido.creadoPor == request.auth.uid
        && pedido.estado == 'recibido'
        && pedido.creadoEn == request.time
        && request.resource.data.totalCentimos == totalAnterior + totalPedido
        && pedido.total == pedido.totalCentimos / 100
        && pedido.items is list
        && pedido.items.size() >= 1
        && pedido.items.size() <= 4
        && mesa.estado == 'ocupada'
        && mesa.atencionActivaId == atencionId
        && mesa.numero == resource.data.mesaNumero;
    }

    function cierreAtencionValido(atencionId) {
      let pago = getAfter(pagoPath(atencionId, request.resource.data.pagoId)).data;
      let mesa = getAfter(mesaPath(resource.data.mesaId)).data;
      let saldo = atencionCentimos(resource.data);
      return request.resource.data.estado == 'cerrada'
        && request.resource.data.cierre == request.time
        && request.resource.data.metodoPago in ['efectivo', 'yape']
        && request.resource.data.pagoId is string
        && request.resource.data.totalPagadoCentimos is int
        && saldo is int
        && request.resource.data.totalPagadoCentimos == saldo
        && pago.metodo == request.resource.data.metodoPago
        && pago.importeCentimos == saldo
        && pago.importe == saldo / 100
        && pago.registradoEn == request.time
        && pago.confirmadoPor == request.auth.uid
        && mesa.estado == 'libre'
        && mesa.atencionActivaId == null;
    }

    function pagoValido(atencionId, pagoId) {
      let actual = get(atencionPath(atencionId)).data;
      let despues = atencionDespues(atencionId).data;
      let mesa = mesaDespues(actual.mesaId).data;
      let saldo = atencionCentimos(actual);
      return actual.estado == 'abierta'
        && actual.mesaId is string
        && saldo is int
        && saldo >= 0
        && request.resource.data.keys().hasAll([
          'metodo', 'importeCentimos', 'importe', 'registradoEn', 'confirmadoPor'
        ])
        && request.resource.data.keys().hasOnly([
          'metodo', 'importeCentimos', 'importe', 'registradoEn', 'confirmadoPor'
        ])
        && request.resource.data.metodo in ['efectivo', 'yape']
        && request.resource.data.importeCentimos is int
        && request.resource.data.importeCentimos == saldo
        && request.resource.data.importe == saldo / 100
        && request.resource.data.registradoEn == request.time
        && request.resource.data.confirmadoPor == request.auth.uid
        && despues.estado == 'cerrada'
        && despues.cierre == request.time
        && despues.metodoPago == request.resource.data.metodo
        && despues.pagoId == pagoId
        && despues.totalPagadoCentimos == saldo
        && mesa.estado == 'libre'
        && mesa.atencionActivaId == null;
    }

    function mesaLiberadaValida(mesaId) {
      let atencionId = resource.data.atencionActivaId;
      let antes = get(atencionPath(atencionId)).data;
      let despues = getAfter(atencionPath(atencionId)).data;
      return resource.data.estado == 'ocupada'
        && atencionId is string
        && request.resource.data.estado == 'libre'
        && request.resource.data.atencionActivaId == null
        && request.resource.data.mozoId == null
        && request.resource.data.mozoNombre == null
        && request.resource.data.comensales == null
        && request.resource.data.inicioAtencion == null
        && antes.mesaId == mesaId
        && despues.estado == 'cerrada'
        && despues.cierre == request.time
        && despues.pagoId is string;
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /mesas/{mesaId} {
      allow read: if isAdmin();

      allow update: if isAdmin() && (
        (resource.data.estado == 'libre'
          && request.resource.data.estado == 'ocupada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'atencionActivaId', 'mozoId', 'mozoNombre', 'comensales', 'inicioAtencion'
          ])
          && request.resource.data.atencionActivaId is string
          && request.resource.data.mozoId == request.auth.uid
          && request.resource.data.mozoNombre is string
          && request.resource.data.comensales is int
          && request.resource.data.comensales >= 1
          && request.resource.data.inicioAtencion == request.time
          && atencionDespues(request.resource.data.atencionActivaId).data.mesaId == mesaId
          && atencionDespues(request.resource.data.atencionActivaId).data.mesaNumero == request.resource.data.numero
          && atencionDespues(request.resource.data.atencionActivaId).data.mozoId == request.auth.uid
          && atencionDespues(request.resource.data.atencionActivaId).data.mozoNombre == request.resource.data.mozoNombre
          && atencionDespues(request.resource.data.atencionActivaId).data.comensales == request.resource.data.comensales
          && atencionDespues(request.resource.data.atencionActivaId).data.estado == 'abierta'
          && atencionDespues(request.resource.data.atencionActivaId).data.inicio == request.time)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'atencionActivaId', 'mozoId', 'mozoNombre', 'comensales', 'inicioAtencion'
        ]) && mesaLiberadaValida(mesaId))
      );

      allow create, delete: if false;
    }

    match /atenciones/{atencionId} {
      allow get: if isAdmin();
      allow list: if false;

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'mesaId', 'mesaNumero', 'mozoId', 'mozoNombre', 'comensales', 'estado',
          'inicio', 'cierre', 'total', 'totalCentimos'
        ])
        && request.resource.data.keys().hasOnly([
          'mesaId', 'mesaNumero', 'mozoId', 'mozoNombre', 'comensales', 'estado',
          'inicio', 'cierre', 'total', 'totalCentimos'
        ])
        && request.resource.data.mesaId is string
        && request.resource.data.mesaNumero is number
        && request.resource.data.mozoId == request.auth.uid
        && request.resource.data.mozoNombre is string
        && request.resource.data.comensales is int
        && request.resource.data.comensales >= 1
        && request.resource.data.estado == 'abierta'
        && request.resource.data.inicio == request.time
        && request.resource.data.cierre == null
        && request.resource.data.total == 0
        && request.resource.data.totalCentimos == 0
        && mesaDespues(request.resource.data.mesaId).data.estado == 'ocupada'
        && mesaDespues(request.resource.data.mesaId).data.atencionActivaId == atencionId
        && mesaDespues(request.resource.data.mesaId).data.numero == request.resource.data.mesaNumero
        && mesaDespues(request.resource.data.mesaId).data.mozoId == request.auth.uid
        && mesaDespues(request.resource.data.mesaId).data.mozoNombre == request.resource.data.mozoNombre
        && mesaDespues(request.resource.data.mesaId).data.comensales == request.resource.data.comensales
        && mesaDespues(request.resource.data.mesaId).data.inicioAtencion == request.time;

      allow update: if isAdmin()
        && ((resource.data.estado == 'abierta'
          && request.resource.data.estado == 'abierta'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'total', 'totalCentimos', 'ultimoPedidoId'
          ])
          && request.resource.data.totalCentimos is int
          && request.resource.data.totalCentimos >= atencionCentimos(resource.data)
          && request.resource.data.total == request.resource.data.totalCentimos / 100
          && request.resource.data.ultimoPedidoId is string
          && atencionActualizacionValida(atencionId))
        || (resource.data.estado == 'abierta'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'cierre', 'metodoPago', 'pagoId', 'totalPagadoCentimos'
          ])
          && cierreAtencionValido(atencionId)));

      allow delete: if false;

      match /pedidos/{pedidoId} {
        allow get: if isAdmin();
        allow list: if isAdmin() && atencionPagadaCerrada(atencionId);

        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly([
            'atencionId', 'mesaId', 'mesaNumero', 'creadoPor', 'creadoEn',
            'estado', 'items', 'total', 'totalCentimos', 'observaciones'
          ])
          && request.resource.data.atencionId == atencionId
          && request.resource.data.mesaId is string
          && request.resource.data.mesaNumero is number
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.creadoEn == request.time
          && request.resource.data.estado == 'recibido'
          && lineasValidas(request.resource.data.items)
          && request.resource.data.totalCentimos is int
          && request.resource.data.totalCentimos == totalLineasCentimos(request.resource.data.items)
          && request.resource.data.total == request.resource.data.totalCentimos / 100
          && (!request.resource.data.keys().hasAny(['observaciones'])
            || (request.resource.data.observaciones is string
              && request.resource.data.observaciones.size() > 0
              && request.resource.data.observaciones.size() <= 500))
          && pedidoCreateValido(request.resource.data, atencionId, pedidoId);

        allow update: if (isAdmin() || isCocina() || isMozo())
          && estadoPedidoActualizacionValida(atencionId, pedidoId);
        allow delete: if false;

        match /cocina/{comandaId} {
          allow get: if ((isAdmin() || isCocina()) && comandaValida(resource.data))
            || (isMozo() && comandaValida(resource.data) && resource.data.estado == 'listo');
          allow list: if ((isAdmin() || isCocina())
            && request.query.limit != null
            && request.query.limit <= 200
            && resource.data.estado in ['recibido', 'preparando', 'listo'])
            || (isMozo() && request.query.limit != null
              && request.query.limit <= 200 && resource.data.estado == 'listo');
          allow create: if isAdmin()
            && comandaId == 'resumen'
            && comandaCreateValida(atencionId, pedidoId);
          allow update: if (isAdmin() || isCocina() || isMozo())
            && comandaId == 'resumen'
            && estadoComandaActualizacionValida(atencionId, pedidoId);
          allow delete: if false;
        }
      }
    }

    // Collection-group reads return only price-free kitchen summaries; full
    // order documents remain unreadable to kitchen and waiter roles.
    match /{path=**}/cocina/{comandaId} {
      allow get: if ((isAdmin() || isCocina()) && comandaValida(resource.data))
        || (isMozo() && comandaValida(resource.data) && resource.data.estado == 'listo');
      allow list: if ((isAdmin() || isCocina())
        && request.query.limit != null
        && request.query.limit <= 200
        && resource.data.estado in ['recibido', 'preparando', 'listo'])
        || (isMozo() && request.query.limit != null
          && request.query.limit <= 200 && resource.data.estado == 'listo');
      allow create, update, delete: if false;
    }

    match /productos/{productoId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && productoValido(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'categoria', 'precio', 'precioCentimos', 'activo', 'presentacion'
        ])
        && productoValido(request.resource.data);
      allow delete: if false;
    }

    // Private reservation records prevent concurrent catalog writes from
    // claiming the same normalized name/category/presentation combination.
    match /clavesProductos/{claveId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['productoId', 'claveNormalizada'])
        && request.resource.data.keys().hasOnly(['productoId', 'claveNormalizada'])
        && request.resource.data.productoId is string
        && request.resource.data.claveNormalizada is string
        && request.resource.data.claveNormalizada.size() > 0
        && request.resource.data.claveNormalizada.size() <= 512
        && existsAfter(productoPath(request.resource.data.productoId));
      allow update: if isAdmin()
        && resource.data.productoId == request.resource.data.productoId
        && request.resource.data.keys().hasAll(['productoId', 'claveNormalizada'])
        && request.resource.data.keys().hasOnly(['productoId', 'claveNormalizada'])
        && request.resource.data.productoId is string
        && request.resource.data.claveNormalizada is string
        && request.resource.data.claveNormalizada.size() > 0
        && request.resource.data.claveNormalizada.size() <= 512
        && existsAfter(productoPath(request.resource.data.productoId));
      allow delete: if isAdmin()
        && resource.data.productoId is string
        && existsAfter(productoPath(resource.data.productoId));
    }

    match /atenciones/{atencionId}/pagos/{pagoId} {
      allow get: if isAdmin();
      allow list: if isAdmin()
        && request.query.limit != null
        && request.query.limit <= 50;
      allow create: if isAdmin() && pagoValido(atencionId, pagoId);
      allow update, delete: if false;
    }

    // Collection-group reads are scoped to pagos below atenciones and limited
    // to active administrators. Writes remain governed by the exact rule above.
    match /{path=**}/pagos/{pagoId} {
      allow list: if isAdmin()
        && request.query.limit != null
        && request.query.limit <= 50;
      allow create, update, delete: if false;
    }
  }
}
